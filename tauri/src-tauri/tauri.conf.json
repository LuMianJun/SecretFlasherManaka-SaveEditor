{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SecretFlasherManaka 存档编辑器",
  "version": "0.4.0",
  "identifier": "local.secretflashermanaka.saveeditor",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "title": "SecretFlasherManaka 存档编辑器",
      "width": 1320, "height": 860, "minWidth": 1000, "minHeight": 680,
      "center": true, "backgroundColor": "#F5F6FA"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'none'",
      "capabilities": [{ "identifier": "main-window", "windows": ["main"], "permissions": ["core:default"] }]
    }
  },
  "bundle": { "active": false }
}
